
# This project is a simple University Staff Management System developed using Object-Oriented Programming (OOP). 
# The Person class is the main parent class that contains common attributes such as id and name. 
# The Staff class inherits from Person and adds staff-specific information such as staff_id and tax_num.
#  The General class inherits from Staff and contains the rate_of_pay attribute, which is used to calculate the total pay based on the number of hours worked.
#  The Academic class also inherits from Staff and represents a lecturer. It contains a list of publications and uses the number_of_publications() method to calculate and display how many publications the lecturer has. 
# The project demonstrates important OOP concepts such as classes, objects, attributes, methods, and inheritance.




# Parent class
class Person:
    def __init__(self, id, name):
        self.id = id
        self.name = name


# Staff class inherits Person
class Staff(Person):
    def __init__(self, id, name, staff_id, tax_num):
        super().__init__(id, name)
        self.staff_id = staff_id
        self.tax_num = tax_num


# General Staff inherits Staff
class General(Staff):
    def __init__(self, id, name, staff_id, tax_num, rate_of_pay):
        super().__init__(id, name, staff_id, tax_num)
        self.rate_of_pay = rate_of_pay

    def calculate_pay(self, hours):
        return self.rate_of_pay * hours


# Academic/Lecturer inherits Staff
class Academic(Staff):
    def __init__(self, id, name, staff_id, tax_num, publications):
        super().__init__(id, name, staff_id, tax_num)
        self.publications = publications

    def number_of_publications(self):
        return len(self.publications)


# Create lecturer
lecturer = Academic(
    1,
    "John",
    "A001",
    "T123",
    ["Research 1", "Research 2", "Research 3"]
)

# Create general staff
general = General(
    2,
    "Sarah",
    "G001",
    "T456",
    25
)


# Display lecturer information
print("=== Lecturer ===")
print("Name:", lecturer.name)
print("Publications:", lecturer.number_of_publications())


# Display general staff information
print("\n=== General Staff ===")
print("Name:", general.name)
print("Pay Rate: $", general.rate_of_pay)

hours = 40
print("Total Pay: $", general.calculate_pay(hours))