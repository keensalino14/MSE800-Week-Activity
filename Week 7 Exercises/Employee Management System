# Employee Management System
# Demonstrating Single Inheritance

# Parent class
class Employee:
    def __init__(self, name, employee_id):
        self.name = name
        self.employee_id = employee_id

    def display_details(self):
        print("Employee Name :", self.name)
        print("Employee ID   :", self.employee_id)


# Child class inherits from Employee
class Manager(Employee):
    def __init__(self, name, employee_id, department):
        # Call the constructor of the parent class
        super().__init__(name, employee_id)
        self.department = department

    def display_details(self):
        # Display the employee details from the parent class
        super().display_details()
        print("Department    :", self.department)


# Create a Manager object
manager = Manager("John Smith", "EMP1001", "Information Technology")

# Display all manager details
print("--- Manager Details ---")
manager.display_details()