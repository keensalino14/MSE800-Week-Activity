
class BankAccount:
    def __init__(self, account_number, customer_name, balance):
        self.account_number = account_number
        self.customer_name = customer_name
        self.balance = balance

    
    def display_details(self):
        print("\n--- Bank Account Details ---")
        print(f"Account Number : {self.account_number}")
        print(f"Customer Name  : {self.customer_name}")
        print(f"Balance        : ${self.balance:.2f}")


    def deposit(self, amount):
        if amount > 0:
            self.balance += amount
            print(f"${amount:.2f} deposited successfully.")
            print(f"New Balance: ${self.balance:.2f}")
        else:
            print("Deposit amount must be greater than $0.")

    
    def withdraw(self, amount):
        if amount <= 0:
            print("Withdrawal amount must be greater than $0.")
        elif amount > self.balance:
            print("Withdrawal failed: Insufficient balance.")
        else:
            self.balance -= amount
            print(f"${amount:.2f} withdrawn successfully.")
            print(f"New Balance: ${self.balance:.2f}")

class SavingsAccount(BankAccount):

    
    def display_account_type(self):
        print("Account Type   : Savings Account")

    
    def calculate_interest(self, interest_rate):
        interest = self.balance * (interest_rate / 100)
        print(f"Interest Rate   : {interest_rate}%")
        print(f"Interest Earned : ${interest:.2f}")
        return interest


# Create a Savings Account object
account = SavingsAccount("SA1001", "John", 5000)

# Display initial account details
account.display_details()
account.display_account_type()

# Deposit $1,000
print("\n--- Deposit Operation ---")
account.deposit(1000)

# Withdraw $500
print("\n--- Withdrawal Operation ---")
account.withdraw(500)

# Calculate interest at 5%
print("\n--- Interest Calculation ---")
account.calculate_interest(5)

# Display final account details
print("\n--- Final Account Details ---")
account.display_details()
account.display_account_type()